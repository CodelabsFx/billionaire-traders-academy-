# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=billionaire_traders_academy

# Server Configuration
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
PUBLIC_SITE_URL=http://localhost:5000

# JWT Configuration
JWT_SECRET=generate-a-long-random-secret-before-deploying
JWT_EXPIRE=7d
JWT_ACCESS_EXPIRE=15m
REFRESH_TOKEN_DAYS=30
TRUST_PROXY=false

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5500

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@billionairetraders.com

# Payment Gateway (Stripe)
STRIPE_PUBLIC_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

# AWS S3 Configuration (Optional - for file uploads)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=billionaire-traders-bucket
AWS_REGION=us-east-1

# File Upload Configuration
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,mp4,webm,mov,m4v

# Logging
LOG_LEVEL=debug

# API Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT=10
